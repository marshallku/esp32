WIFI_SSID=YourWifiName
WIFI_PASSWORD=YourWifiPassword
INFLUX_URL=http://your-influx-host:8086
INFLUX_ORG=your-org
INFLUX_BUCKET=your-bucket
INFLUX_TOKEN=your-api-token

# Line Protocol measurement (shared).
INFLUX_MEASUREMENT=air

# Per-board tags live in .env.<location> — see .env.main_room / .env.living_room.
# Example .env.living_room contents:
#   INFLUX_TAGS=host=esp32s3,location=living_room

# homelab-display: pre-aggregated status document served by pi01
# (manifest: docker-compose/pi01/homelab-status).
STATUS_URL=http://192.168.219.127:8080/homelab.json
# Must match STATUS_TOKEN in that stack's own .env on pi01.
# Generate with: openssl rand -hex 24
STATUS_TOKEN=
